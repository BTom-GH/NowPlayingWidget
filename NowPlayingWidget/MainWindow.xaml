<Window x:Class="NowPlayingWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NowPlaying" Height="80" Width="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Opacity="1"
        ResizeMode="NoResize"
        >

    <Window.Resources>
        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBg" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Border Background="#CC141414" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="14" Padding="10">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Album Art -->
            <Image x:Name="AlbumArt" Grid.Column="0" Width="56" Height="56" Margin="0,0,12,0" Stretch="UniformToFill">
                <Image.Clip>
                    <RectangleGeometry Rect="0,0,56,56" RadiusX="8" RadiusY="8"/>
                </Image.Clip>
            </Image>

            <!-- Column 1: Title & Artist (auto-truncates with "..." if too long) -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="TitleText" Text="Waiting for music..." 
                           Foreground="White" FontFamily="Segoe UI" FontSize="14" 
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Text="" 
                           Foreground="#99FFFFFF" FontFamily="Segoe UI" FontSize="12" 
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Column 2: Controls anchored on the right -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="BtnPrev_Click" Style="{StaticResource MediaButtonStyle}">
                    <Path Data="M 0,1 H 1.8 V 11 H 0 Z M 2.8,6 L 10.5,1 V 11 Z" 
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>

                <Button Click="BtnPlayPause_Click" Style="{StaticResource MediaButtonStyle}" Margin="2,0">
                    <Path x:Name="PlayPauseIcon"
                          Data="M 0,1 L 9,6 L 0,11 Z" 
                          Margin="2,0,0,0"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>

                <Button Click="BtnNext_Click" Style="{StaticResource MediaButtonStyle}">
                    <Path Data="M 0,1 L 7.7,6 L 0,11 Z M 8.7,1 H 10.5 V 11 H 8.7 Z" 
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>